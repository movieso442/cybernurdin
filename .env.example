# Supabase Postgres connection (server-only — never expose this to the
# browser). Supabase's transaction pool mode (port 6543) requires
# `prepare: false` in src/lib/db.ts, which is already set.
DATABASE_URL=

# Supabase client config
# NEXT_PUBLIC_* values are safe to expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-only, never
# import it from a Client Component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production site URL, used to resolve SEO metadata, sitemap, and Open Graph
# image URLs (e.g. https://cybernurdin.com). Must be set before deploying —
# there is a fallback for local dev only.
NEXT_PUBLIC_SITE_URL=

# Seed accounts (scripts/seed.ts). If passwords are left blank, strong random
# passwords are generated and printed once in the terminal — never commit
# real values here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
SEED_STUDENT_FULL_NAME=

# Coupon email delivery (optional). If unset, the admin UI shows the
# generated coupon code once so it can be copied manually.
EMAIL_PROVIDER_API_KEY=
FROM_EMAIL=

# BigBlueButton (optional, future-only — not used in this deployment; no live
# session server is required to run CyberNurdin)
BBB_SERVER_URL=
BBB_SECRET=
